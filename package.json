    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "gsap": "3.15.1"
  },
  "devDependencies": {
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
